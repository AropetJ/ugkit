# --- dependencies & build output ---
node_modules/
dist/
coverage/
*.tsbuildinfo
*.log

# --- OS noise ---
.DS_Store
Thumbs.db

# --- secrets & credentials — never commit these ---
.env
.env.*
!.env.example
.npmrc
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials.*

# --- AI assistant / agent files (local working context, not project source) ---
CLAUDE.md
CLAUDE.local.md
.claude/
**/.claude/
AGENTS.md
GEMINI.md
.cursor/
.cursorrules
.aider*
.codeium/
.copilot/

# --- large sourced artifacts ---
# Provenance is recorded via URLs in data/PROVENANCE.md and
# scripts/ingest/SAMPLES.md; do not commit the raw PDFs or extracted text.
# Exceptions: the UBOS frame (~1.3 MB) is committed so the live ingest
# (build-ubos-frame.mjs) is reproducible from a fresh clone.
packages/ug-locale/scripts/ingest/sources/*
!packages/ug-locale/scripts/ingest/sources/ubos-parishes-*
# ...and the parsed EC village list (5 MB CSV; the 10.8 MB PDF stays out).
!packages/ug-locale/scripts/ingest/sources/ec-villages-2022.csv
